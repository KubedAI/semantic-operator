# Generated by `ossiectl derive`. The spec.ossie block is an Apache Ossie
# semantic_model entry conforming to the Ossie core spec (v{{ .SpecVersion }}):
#   https://github.com/apache/ossie/blob/main/core-spec/spec.md
# Physical structure (datasets, fields) is populated from the catalog.
# Date and timestamp fields are marked as time dimensions. Other fields stay
# non-dimensional until you add dimension: {} after semantic review.
# Business semantics (metrics, relationships, synonyms, governance) are
# placeholders marked TODO for a human to fill. connection/governance/views
# are operator extensions kept outside the portable spec.ossie block.
{{- if .Enriched }}
# Descriptions, synonyms, and denyFields below were imported from your
# metadata catalog. Review them: they reflect what that catalog recorded, and
# you own what this model certifies. Metrics are never imported.
{{- end }}
apiVersion: {{ yamlValue .APIVersion }}
kind: SemanticModel
metadata:
  name: {{ yamlValue .Options.CRName }}
  namespace: {{ yamlValue .Options.Namespace }}
spec:
  connection:
    catalog: {{ yamlValue .Options.Catalog }}        # query-engine catalog fronting the lake
    database: {{ yamlValue .Options.Database }}
    viewDatabase: semantic_views   # use catalog.semantic_views on Trino
  ossie:
    name: {{ yamlValue .Options.Model }}
    description: ""                 # TODO: one line describing this model
    # ai_context guides LLM agents. Fill in and uncomment.
    # ai_context:
    #   instructions: >-
    #     TODO: what this model is for; call out any metric whose definition
    #     differs from naive per-row math (e.g. fan-out-safe ratios).
    datasets:
{{- range .Datasets }}
      - name: {{ yamlValue .Name }}
{{- if .Deprecated }}
        # REVIEW: your metadata catalog marks this dataset deprecated.
        # Remove it from the model, or confirm it is still certified.
{{- end }}
        source: {{ yamlValue .Source }}
        primary_key: []              # TODO: set PK column(s), e.g. [{{ yamlValue .ExampleKey }}]; required for fan-out-safe ratio metrics
        # unique_keys:               # TODO: optional; other unique keys, each [col] or [col1, col2]
{{- if .Description }}
        description: {{ yamlValue .Description }}
{{- else }}
        # description: ""            # TODO: describe this dataset
{{- end }}
{{- if .Synonyms }}
        ai_context:
          synonyms: {{ yamlValue .Synonyms }}
{{- else }}
        # ai_context:
        #   synonyms: []             # TODO: business names, e.g. ["sales", "transactions"]
{{- end }}
{{- if .Fields }}
        fields:
{{- range .Fields }}
          - name: {{ yamlValue .Name }}
            expression:
              dialects:
                - dialect: ANSI_SQL
                  expression: {{ yamlValue .Expression }}
{{- if .IsTime }}
            dimension:
              is_time: true
{{- end }}
{{- if .Description }}
            description: {{ yamlValue .Description }}
{{- end }}
{{- if .Synonyms }}
            ai_context:
              synonyms: {{ yamlValue .Synonyms }}
{{- end }}
{{- if .Sensitive }}
            # Classified sensitive upstream; denied in governance below.
{{- end }}
{{- end }}
{{- else }}
        fields: []                   # (no columns found for this table in the catalog)
{{- end }}
{{- end }}

    # relationships: Glue/Iceberg do not record foreign keys. The edges below
    # were inferred from *_sk / *_id naming. Review each and move the correct
    # ones into the list (delete the leading '#').
    relationships: []
{{- range .Relationships }}
    #  - name: {{ yamlValue .Name }}
    #    from: {{ yamlValue .From }}
    #    to: {{ yamlValue .To }}
    #    from_columns: {{ yamlValue .FromColumns }}
    #    to_columns: {{ yamlValue .ToColumns }}
    #    # {{ yamlValue .Reason }}
{{- end }}

    # metrics: certified aggregate definitions, the core of the model. A model
    # with no metrics validates but answers nothing; define at least one. Example:
    metrics: []
    #  - name: total_sales
    #    expression:
    #      dialects:
    #        - dialect: ANSI_SQL
    #          expression: SUM(store_sales.ss_ext_sales_price)
    #    description: Total sales revenue
    #    ai_context:
    #      synonyms: ["revenue", "total sales", "gross sales"]

{{- if .DeniedFields }}

  # governance: compile-time row/column access policy. The denied fields below
  # were classified sensitive in your metadata catalog. A request for one of
  # them fails to compile (HTTP 403) before any SQL reaches the engine.
  governance:
    defaultRole: analyst
    roles:
      - name: analyst
        allowMetrics: ["*"]
        denyFields:
{{- range .DeniedFields }}
          - {{ yamlValue . }}
{{- end }}
        # rowFilters: []               # TODO: optional row policy, e.g.
                                       #   - dataset: store
                                       #     predicate: "s_state = 'TX'"
{{- else }}

  # governance: compile-time row/column access policy. Uncomment and edit.
  # governance:
  #   defaultRole: analyst
  #   roles:
  #     - name: analyst
  #       allowMetrics: ["*"]
  #       denyFields: []                 # e.g. ["customer.c_email_address"]
{{- end }}

  # views: governed BI views materialized in the query engine. Before using a
  # field here, declare dimension: {} on that field. Uncomment and edit.
  # views:
  #   - name: sales_by_category
  #     metrics: [total_sales]
  #     dimensions: [item.i_category]
  #     role: analyst

  # joins: per-relationship join type override (INNER default). Uncomment and edit.
  # joins:
  #   - relationship: <relationship_name>
  #     type: LEFT
